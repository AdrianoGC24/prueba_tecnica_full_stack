# =============================================================================
# VARIABLES DE ENTORNO DE EJEMPLO (Monorepo)
# Copia este archivo como .env en la raíz del proyecto para usar Docker Compose
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5433

# --- Seguridad Compartida entre Microservicios (Express <-> FastAPI) ---
JWT_SECRET=secreto_compartido_mineria_2026_seguro
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN=8h

# --- Servicio 1: Auth Service (Express + TypeScript) ---
AUTH_PORT=4000
AUTH_DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/auth_db

# --- Servicio 2: Business Service (FastAPI + Python) ---
BUSINESS_PORT=8000
BUSINESS_DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/business_db

# --- Frontend (React + TypeScript) ---
FRONTEND_PORT=3000
CORS_ORIGIN=http://localhost:3000
VITE_AUTH_API_URL=http://localhost:4000/api
VITE_BUSINESS_API_URL=http://localhost:8000/api
